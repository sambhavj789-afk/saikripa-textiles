# ─── Frontend (Vite) ───────────────────────────────────────────────
# Only VITE_-prefixed vars are exposed to the browser. NEVER put a
# secret (e.g. the Supabase service-role key) in this file.
# The anon key is safe to expose — it is gated by Row Level Security.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
