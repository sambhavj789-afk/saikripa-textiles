# ─── Backend (Express) ─────────────────────────────────────────────
# These run only on the server and are NEVER sent to the browser.
# SUPABASE_SERVICE_KEY bypasses Row Level Security — keep it secret.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
PORT=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Comma-separated allowlist of admin emails for the API's requireAdmin gate.
# If empty, any authenticated user is treated as admin (with a logged warning).
# e.g. ADMIN_EMAILS=owner@saikripa.com,manager@saikripa.com
ADMIN_EMAILS=
